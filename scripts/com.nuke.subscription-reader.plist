<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nuke.subscription-reader</string>

    <!-- The owner's subscription readers (2026-11-08, owner decision: "ai read should be fueled by my subscription").
         Each fire: a bounded batch of photographed documents through receipt-photo-ocr and a bounded batch of
         unclassified photos through photo-pipeline-orchestrator, both read with `claude -p` under the owner's Claude
         Code login on this Mac. Runs in the login shell (full network, outside Claude Code's sandbox). The wrapper
         refreshes ~/.worktrees/nuke-main from origin/main each full fire and writes a heartbeat row per reader to
         job_assay_readings. Install: cp scripts/com.nuke.subscription-reader.plist ~/Library/LaunchAgents/ &&
         launchctl bootout gui/$(id -u)/com.nuke.subscription-reader; launchctl bootstrap gui/$(id -u)
         ~/Library/LaunchAgents/com.nuke.subscription-reader.plist -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/skylar/.worktrees/nuke-main/scripts/photo-pipeline/subscription-reader-batch.sh</string>
        <string>20</string>
        <string>20</string>
    </array>

    <!-- One minute between fires (2026-11-20; it was ten). The wrapper decides what a fire is: a full fire (documents,
         frames, every stage, a heartbeat each) when the last one started about ten minutes ago, and otherwise a fast
         fire, which asks the stage ledger whether a newly landed photo is waiting for its first read and starts the
         reader only then. A minute with nothing to read costs three small requests and writes nothing. launchd runs
         one instance of a job, so a fire that is still reading is never joined by a second. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/skylar/nuke/logs/subscription-reader.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/skylar/nuke/logs/subscription-reader.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/skylar/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
