<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nuke.clip-embed</string>

    <!-- CLIP embedding drainer. clip-embed-drain.sh runs the local CLIP ViT-B/32 embedder (MPS, zero API
         cost) with --all: every active image_observations row without an embedding, newest photo first,
         then exits. The embeddings are the visual leg of capture_sets_score, which is what files a phone
         photo to a vehicle, so this job is part of the photo pipeline: a photo that lands is embedded
         within one interval. The wrapper runs the scripts of ~/.worktrees/nuke-main (origin/main, kept
         fresh by the subscription reader), picks an interpreter that has the model's libraries, and keeps
         fires from overlapping.

         Runs in the login shell (NOT Claude Code's Bash sandbox) so it reaches Supabase + MPS.
         This repo copy is the source of truth; keep it identical to
         ~/Library/LaunchAgents/com.nuke.clip-embed.plist. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/skylar/.worktrees/nuke-main/scripts/daily-receipt/clip-embed-drain.sh</string>
    </array>

    <!-- 5 min between fires. A fire that finds nothing to embed costs one RPC (the model is loaded only
         when there is a row); the lock makes a fire a no-op while a long drain runs. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/skylar/nuke/logs/clip-embed.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/skylar/nuke/logs/clip-embed.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/skylar/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
