<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ag.nuke.fb-capture</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin"; exec node "$HOME/nuke-fb/app/playwright/runner.mjs" --mode search</string>
    </array>
    <key>StartInterval</key>
    <integer>1200</integer>
    <key>StandardOutPath</key>
    <string>/Users/skylarwilliams/nuke-fb/logs/capture.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/skylarwilliams/nuke-fb/logs/capture.log</string>
</dict>
</plist>
