{
  "manifest_version": 3,
  "name": "Nuke Marketplace Capture",
  "version": "1.1.0",
  "description": "Permitted rendered Marketplace captures through Nuke’s existing intake.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.facebook.com/marketplace/*",
    "https://facebook.com/marketplace/*",
    "https://www.facebook.com/saved/*",
    "https://facebook.com/saved/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nuke Marketplace Capture"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
