  "method": "Each value was read by hand from the house's own page (or the house's own public listing API where the page is client-rendered) at the evidence clock below, never from a Nuke extractor. Values are as published: source fidelity, not physical truth. A field the source does not publish is omitted; omission is not-applicable, not missing.",
  "conventions": {
    "comment_count": "non-bid comments as the house counts them (BaT's 'N Comments' and Cars & Bids' stats.comments both exclude bids)",
    "bid_count": "bids on the lot as the house counts them",
    "hammer_price": "the price without buyer's premium, where the house publishes that figure (BaT, Cars & Bids, Mecum, PCarMarket, Collecting Cars)",
    "price_with_premium": "the published price including buyer's premium (Bonhams 'inc. premium', RM Sotheby's, Gooding, Broad Arrow)",
    "high_bid": "the top bid at close for a lot that did not sell, or the current bid of a live lot at the evidence clock",
    "outcome": "sold | not_sold | live | upcoming",
    "match": "every listed token must appear (case- and punctuation-insensitive) in one model value",
    "match_any": "at least one listed token must appear in one model value",
    "approx": "the source rounds (e.g. '13k Miles'); compared within 5% or 1,000",
    "one_of": "any listed value is correct (e.g. a two-day sale whose lot day is not published)",
    "perishable": "the lot was open at the evidence clock; after auction_end its outcome, bid and count fields are reported stale, not graded"
  },
  "evidence_store": "listing_page_snapshots rows are cited by id. Pages fetched directly (free) and house-API records are pinned by sha256; the bytes are kept with the run receipt, not in this public repo.",
