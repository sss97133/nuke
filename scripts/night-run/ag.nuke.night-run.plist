<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Nightly repair-loop run (scripts/night-run/run.sh): one bounded Claude Code session on the owner's subscription
       (claude -p, ANTHROPIC_API_KEY unset for the child) that works work-order.md's three items and opens PRs for the lead's
       morning review. Never merges, deploys, pushes to main or loads jobs. Report: ~/nuke-logs/night-run/<UTC date>.md;
       transcript beside it. The script runs from ~/nuke's git only to fetch and add the night's worktree at origin/main.
       NOT LOADED until the data-model lead has reviewed work-order.md line by line. To load:
       cp scripts/night-run/ag.nuke.night-run.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/ag.nuke.night-run.plist
       Stop: launchctl unload the same file. Runs at 01:30 local time, two hours before the stack generator (03:30), so the
       two never share the machine. gtimeout in run.sh caps the session at 45 minutes.
       Repo copy is source of truth; keep identical to ~/Library/LaunchAgents/ag.nuke.night-run.plist. -->
  <key>Label</key><string>ag.nuke.night-run</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd "$HOME/nuke" &amp;&amp; git fetch -q origin main &amp;&amp; git show origin/main:scripts/night-run/run.sh | /bin/bash -s</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/skylar/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/skylar/nuke-logs/night-run/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/skylar/nuke-logs/night-run/launchd.log</string>
</dict>
</plist>
