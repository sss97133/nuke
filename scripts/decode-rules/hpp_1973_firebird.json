   "rule_key": "body_tag_line_format",
   "code": "1973_cowl",
   "value": {
    "location": "top of the cowl, ahead of the windshield, driver side",
    "lines": {
     "1": "Body By Fisher",
     "2": "ST <model year> <style number> <plant> <body number> BDY",
     "3": "TR <trim> <seat> <paint lower> <paint upper> PNT",
     "4": "<build date> <option codes>",
     "5": "code line (700809 in the example) not yet deciphered",
     "6": "General Motors Corporation"
    },
    "example": "ST 73 2FS87 NOR 170011 BDY / TR 242 A51 51 51 PNT / 06B W66 / 700809",
    "body_number_note": "consecutive body number, no direct correlation to the VIN"
   },
   "locator": "pp.19-20 (PDF pp.10-11), Cowl Data Plates"
