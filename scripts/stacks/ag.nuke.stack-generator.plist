<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Nightly local stack generator (scripts/stacks/propose.mjs): asks the local Odysseus + Qwen 3.5 9B for STACKS_N new data
       stacks, measures them read-only against the live data model, appends ~/nuke-logs/stacks/proposals/<UTC>.jsonl and
       rewrites ~/nuke-logs/stacks/INDEX.md. Zero API spend; reads the database through scripts/data/q.sh only.
       Runs from the runner worktree ~/.worktrees/stacks-nightly, fetched and detached to origin/main before each run
       (~/nuke is a shared checkout on whatever branch a session left it on). The .env comes from ~/nuke through dotenvx -f.
       To load: (1) Ollama must be serving qwen3.5:9b; (2) the runner worktree must exist
       (git -C ~/nuke worktree add --detach ~/.worktrees/stacks-nightly origin/main); then copy this file to
       ~/Library/LaunchAgents/ and launchctl load it.
       Stop: launchctl unload the same file. Runs at 03:30 local time, caffeinate keeps the Mac awake while it works, gtimeout
       stops it after 30 minutes (propose.mjs also ends gracefully at 25). PATH adds ~/.local/bin, where ody lives.
       STACKS_ASKER=auto asks `ody ask` first and, if the workspace is down, the token is missing or the reply comes back empty,
       asks the already-running Ollama server directly (same Qwen 3.5 9B, thinking off); every proposal records which one answered.
       Measured 2026-10-07: through Odysseus today Qwen 3.5 spends all 4096 reply tokens thinking (Ollama ignores think:false
       on /v1), so ody alone returns empty replies; at 05:00Z a 3-proposal run through ody took 171 s + 232 s of repair and
       admitted 0 of 6 (malformed). Straight to Ollama at 05:06Z the same 3-proposal run took 196 s + 14 s + 14 s and
       recorded 3 of 3, each measured live. The job therefore asks Ollama directly (STACKS_ASKER=ollama).
       Repo copy is source of truth; keep identical to ~/Library/LaunchAgents/ag.nuke.stack-generator.plist. -->
  <key>Label</key><string>ag.nuke.stack-generator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd "$HOME/.worktrees/stacks-nightly" &amp;&amp; git fetch -q origin main &amp;&amp; git checkout -q --detach origin/main &amp;&amp; exec /usr/bin/caffeinate -i /opt/homebrew/bin/gtimeout -k 60 30m /opt/homebrew/bin/dotenvx run -q -f "$HOME/nuke/.env" -- /opt/homebrew/bin/node scripts/stacks/propose.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/skylar/.worktrees/stacks-nightly</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/skylar/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>STACKS_N</key><string>20</string>
    <key>STACKS_ASKER</key><string>ollama</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/skylar/nuke-logs/stacks/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/skylar/nuke-logs/stacks/launchd.log</string>
</dict>
</plist>
