<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Nightly local stack generator (scripts/stacks/propose.mjs): asks the local Odysseus + Qwen 3.5 9B for STACKS_N new data
       stacks, measures them read-only against the live data model, appends ~/nuke-logs/stacks/proposals/<UTC>.jsonl and
       rewrites ~/nuke-logs/stacks/INDEX.md. Zero API spend; reads the database through scripts/data/q.sh only.
       NOT LOADED. To load: (1) the Odysseus workspace must be running (cd ~/odysseus && ./start-macos.sh) and
       ODYSSEUS_API_TOKEN must be in the dotenvx environment of ~/nuke; (2) ~/nuke must be on a commit that contains
       scripts/stacks (this folder), or edit the one path below to a worktree on main; (3) ~/nuke-logs/stacks must exist
       (propose.mjs creates it on its first run); then: launchctl load ~/Library/LaunchAgents/ag.nuke.stack-generator.plist.
       Stop: launchctl unload the same file. Runs at 03:30 local time, caffeinate keeps the Mac awake while it works, gtimeout
       stops it after 30 minutes (propose.mjs also ends gracefully at 25). PATH adds ~/.local/bin, where ody lives.
       STACKS_ASKER=auto asks `ody ask` first and, if the workspace is down, the token is missing or the reply comes back empty,
       asks the already-running Ollama server directly (same Qwen 3.5 9B, thinking off); every proposal records which one answered.
       Measured 2026-10-07: through Odysseus today Qwen 3.5 spends all 4096 reply tokens thinking (Ollama ignores think:false
       on /v1), so ody alone returns empty replies; set STACKS_ASKER=ody to insist on it, or ollama to skip it.
       Repo copy is source of truth; keep identical to ~/Library/LaunchAgents/ag.nuke.stack-generator.plist. -->
  <key>Label</key><string>ag.nuke.stack-generator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/opt/homebrew/bin/gtimeout</string>
    <string>-k</string>
    <string>60</string>
    <string>30m</string>
    <string>/opt/homebrew/bin/dotenvx</string>
    <string>run</string>
    <string>-q</string>
    <string>--</string>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/skylar/nuke/scripts/stacks/propose.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/skylar/nuke</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/skylar/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>STACKS_N</key><string>20</string>
    <key>STACKS_ASKER</key><string>auto</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/skylar/nuke-logs/stacks/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/skylar/nuke-logs/stacks/launchd.log</string>
</dict>
</plist>
